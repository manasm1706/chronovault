<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== STATUS BADGE STYLES ===== -->

    <style name="Widget.ChronoVault.Badge" parent="">
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
        <item name="android:paddingTop">@dimen/spacing_xs</item>
        <item name="android:paddingBottom">@dimen/spacing_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.ChronoVault.LabelSmall</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.ChronoVault.Badge.Locked" parent="Widget.ChronoVault.Badge">
        <item name="android:background">@drawable/badge_locked_bg</item>
    </style>

    <style name="Widget.ChronoVault.Badge.Unlocked" parent="Widget.ChronoVault.Badge">
        <item name="android:background">@drawable/badge_unlocked_bg</item>
    </style>

    <style name="Widget.ChronoVault.Badge.Shared" parent="Widget.ChronoVault.Badge">
        <item name="android:background">@drawable/badge_shared_bg</item>
    </style>

    <style name="Widget.ChronoVault.Badge.Nearby" parent="Widget.ChronoVault.Badge">
        <item name="android:background">@drawable/badge_nearby_bg</item>
    </style>

    <!-- ===== TOOLBAR ===== -->

    <style name="Widget.ChronoVault.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="elevation">@dimen/elevation_none</item>
    </style>

    <!-- ===== STAT CARD (for Home dashboard) ===== -->

    <style name="Widget.ChronoVault.StatCard" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">@dimen/spacing_md</item>
    </style>

</resources>

